# Copiar este archivo como ".env" y completar con valores reales
# El archivo ".env" NUNCA debe subirse al repositorio

# Clave secreta usada por Flask para firmar la sesión y el CSRF.
# Generar una propia, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_este_valor_por_uno_seguro_y_unico

# Entorno: development o production
FLASK_ENV=development

# Puerto en el que corre el servidor
PORT=5000

# Origen del frontend permitido para CORS. Solo relevante si el frontend se
# sirve desde un servidor/dominio distinto al backend (ej. en desarrollo con
# "python -m http.server 5500"). En producción, con frontend y API en el
# mismo dominio, esta variable no se usa.
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Base de datos.
# - Si se deja vacía: se usa SQLite local (backend/instance/encuentrau_dev.db),
#   pensado solo para desarrollo.
# - En producción: URL completa de PostgreSQL, por ejemplo
#   postgresql://usuario:password@host:5432/nombre_bd
# NUNCA escribir aquí una credencial real: este archivo es de ejemplo.
DATABASE_URL=
