# Copiar este archivo como ".env" y completar con valores reales.
# El archivo ".env" NUNCA debe subirse al repositorio (está en .gitignore).

# Clave secreta para firmar la sesión, los tokens CSRF y los códigos de retiro.
# Generar una propia: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_este_valor_por_uno_seguro_y_unico

# Entorno: development o production
FLASK_ENV=development

# Puerto en el que corre el servidor
PORT=5000

# Dirección pública de la app: se usa en los enlaces de los correos.
URL_PUBLICA=http://127.0.0.1:5000

# Solo se pueden registrar correos de este dominio
DOMINIO_CORREO_INSTITUCIONAL=sanmateo.edu.co

# Proxies confiables delante de la app (0 en local; 1 en Render).
NUM_PROXIES=0

# Origen del frontend permitido para CORS. Solo relevante si el frontend se
# sirve desde otro servidor (ej. "python -m http.server 5500"). Con frontend
# y API en el mismo dominio, no se usa.
FRONTEND_ORIGIN=http://127.0.0.1:5500

# --- Base de datos (PostgreSQL) ---
# Ver database/scripts/crear_bd_local.sql para crear los usuarios y bases locales.
# La aplicación usa el usuario de permisos mínimos:
DATABASE_URL=postgresql://encuentrau_app:CLAVE_APP@localhost:5432/encuentrau_dev
# Las migraciones (flask db upgrade) y los respaldos usan el usuario dueño:
DATABASE_URL_MIGRACIONES=postgresql://encuentrau:CLAVE_DUENO@localhost:5432/encuentrau_dev

# Base de datos de pruebas (pytest). Se BORRA en cada ejecución: nunca la de desarrollo.
TEST_DATABASE_URL=postgresql://encuentrau_app:CLAVE_APP@localhost:5432/encuentrau_test
TEST_DATABASE_URL_MIGRACIONES=postgresql://encuentrau:CLAVE_DUENO@localhost:5432/encuentrau_test

# --- Correos ---
# consola: se imprimen en la terminal del servidor (desarrollo)
# brevo:   se envían por la API de Brevo (obligatorio en producción)
CORREO_PROVEEDOR=consola
BREVO_API_KEY=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=EncuentraU
